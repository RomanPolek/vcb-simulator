	"assembly": "# you must interweave instructions -\n# cannot use the result of one instaruction\n# in following instruction\n# no need to insert noops everywhere but you can cleverly interweave the operations e.g.\n# x = x * z\n# y = y * z\n# z = x + z etc...\n\nsymbol NULL 0x00\nsymbol NO_ARGS NULL\n# these mark arguments as uniform e.g.\n# argsu a b UNIFORM_A NULL\nsymbol UNIFORM_A 0x8000\nsymbol UNIFORM_B 0x80000000\n\nsymbol RECIPROCAL 0\nsymbol SQRT 1\nsymbol RECIPROCAL_SQRT 2\nsymbol SIN 3\n\n# used to specify arguments to an instruction.\n# every instruction must be followed by args\n# with args, each core uses it's own values\nmacro args {((a? & 0xffff) | (b? & 0xffff) << 16)}\n#args variant that allows defining uniforms\nmacro argu {((a? & 0xffff) | (b? & 0xffff) << 16) | c? | d?}\n\n# simply does nothing\nmacro noop {(0 << 8) << 16}\nmacro mov {(1 << 8) << 16 | (a? & 0xffff)} # samwe as or\nmacro or {(1 << 8) << 16 | (a? & 0xffff)}\nmacro and {(2 << 8) << 16 | (a? & 0xffff)}\nmacro xor {(3 << 8) << 16 | (a? & 0xffff)}\n# first argument - what to shift\n# second argument - by how much to shift\n# lshift = a * b ^ 2\n# rshift = a / b ^ 2\nmacro lshift {(4 << 8) << 16 | (a? & 0xffff)}\nmacro rshift {(5 << 8) << 16 | (a? & 0xffff)}\nmacro add {(6 << 8) << 16 | (a? & 0xffff)}\nmacro sub {(7 << 8) << 16 | (a? & 0xffff)}\nmacro mul {(8 << 8) << 16 | (a? & 0xffff)}\nmacro min {(9 << 8) << 16 | (a? & 0xffff)}\nmacro max {(10 << 8) << 16 | (a? & 0xffff)}\nmacro lookup {((11 + (a? & 0x3)) << 8) << 16 | (b? & 0xffff)}\nmacro call {(15 << 8) << 16 | (a? & 0xffff)}\nmacro ret {(16 << 8) << 16}\nmacro jump {(17 << 8) << 16 | (a? & 0xffff)}\nmacro comp {(18 << 8) << 16} # use comp before conditional jumps\n# conditional jumps. These take NO_ARGS\nmacro jeq {(19 << 8) << 16 | (a? & 0xffff)}\nmacro jne {(20 << 8) << 16 | (a? & 0xffff)}\nmacro jlt {(21 << 8) << 16 | (a? & 0xffff)}\nmacro jle {(22 << 8) << 16 | (a? & 0xffff)}\n# mask commands. No need for COMP for these\nmacro meq {(23 << 8) << 16}\nmacro mne {(24 << 8) << 16}\nmacro mlt {(25 << 8) << 16}\nmacro mle {(26 << 8) << 16}\nmacro mrt {(27 << 8) << 16} # reset mask\nmacro draw {(28 << 8) << 16 | (a? & 0xffff)} #xyrgb pointer\nmacro halt {(29 << 8) << 16}\nmacro rand {(30 << 8) << 16 | (a? & 0xffff)} # generates random 16bit number\n#definition of any constants etc...\norigin 0x10001\nbookmark Variables\npointer core_id inline 0x0001_0000\nNULL; NULL #offset for the draw location\npointer draw_yx inline 0x0000\npointer draw_r inline 0x00\npointer draw_gb inline 0x0000\n\n# screen position, 0,0 is top left\npointer screen_x inline 0x0000\npointer screen_y inline 0x0000\n# pixel position 0,0 is in the middle of the screen\npointer pixel_x inline 0x0000\npointer pixel_y inline 0x0000\n# pixel color\npointer pixel_r inline 0x0000\npointer pixel_g inline 0x0000\npointer pixel_b inline 0x0000\npointer pixel_w inline 0x0000 # if it's 1 the pixel will be written\n\n# ray position & direction in 3D\npointer ray_pos_x inline 0x0000\npointer ray_pos_y inline 0x0000\npointer ray_pos_z inline 0x0000\n\npointer ray_dir_x inline 0x0000\npointer ray_dir_y inline 0x0000\npointer ray_dir_z inline 0x0000\n\npointer hit_x inline 0x00000\npointer hit_y inline 0x00000\npointer hit_z inline 0x00000\n\npointer normal_x inline 0x00000\npointer normal_y inline 0x00000\npointer normal_z inline 0x00000\n\n\n# work variables\npointer a inline 0\npointer b inline 0\npointer c inline 0\npointer d inline 0\npointer e inline 0\npointer f inline 0\npointer cr inline 0\npointer cg inline 0\npointer cb inline 0\n\n# constant literals\npointer u_0 inline 0\npointer u_1 inline 1\npointer u_2 inline 2\npointer u_3 inline 3\npointer u_4 inline 4\npointer u_5 inline 5\npointer u_6 inline 6\npointer u_7 inline 7\npointer u_8 inline 8\npointer u_16 inline 16\npointer u_32 inline 32\npointer u_64 inline 64\npointer u_96 inline 96\npointer u_128 inline 128\npointer u_255 inline 255\n\n# frequently used with floats\npointer u_h1 inline 0x0100\npointer u_h2 inline 0x0200\npointer u_h4 inline 0x0400\npointer u_h8 inline 0x0800\npointer u_h16 inline 0x1000\npointer u_h32 inline 0x2000\npointer u_h64 inline 0x4000\npointer u_minus_1 inline 0xff00\n\npointer u_display_size inline 128\npointer u_pass_index inline 0 # first pass environment, then sphere 1, then sphere 2 etc...\npointer u_focal_length inline 0x5000 # float\npointer u_sphere_x inline 0x0000\npointer u_sphere_y inline 0xff8f\npointer u_sphere_z inline 0x0180\npointer u_sphere_size inline 0x00e0\n\npointer u_sphere_r inline 0x00ff\npointer u_sphere_g inline 0x0090\npointer u_sphere_b inline 0x00aa\npointer u_sphere_reflectivity inline 0x0080\npointer u_sphere_specular inline 0x00c0 # float\n# must be normalised\npointer u_light_dir_x inline 0xffa6\npointer u_light_dir_y inline 0xffa6\npointer u_light_dir_z inline 0xff9a\n\n# environment variables\npointer u_grass_r inline 0x004b\npointer u_grass_g inline 0x006f\npointer u_grass_b inline 0x0044\n\npointer u_dirt_r inline 0x006b\npointer u_dirt_g inline 0x0057\npointer u_dirt_b inline 0x0047\n\npointer u_ocean_r inline 0x002b\npointer u_ocean_g inline 0x0065\npointer u_ocean_b inline 0x00ec\npointer u_ocean_height inline 0x0040\npointer u_ocean_wave_height inline 0x00a0\npointer u_ocean_wave_magic inline 0x3173\n\npointer u_sky_zenith_r inline 0x001e\npointer u_sky_zenith_g inline 0x0090\npointer u_sky_zenith_b inline 0x00ff\npointer u_sky_horizon_r inline 0x0087\npointer u_sky_horizon_g inline 0x00ce\npointer u_sky_horizon_b inline 0x00eb\npointer u_sky_height inline 0x0005\n\norigin 0x20001\n0x0003_0002 # core_id for the remaining cores\n\norigin 0x0001\nbookmark Display\npointer display inline 0x80000\n\norigin 0x0002\nbookmark CodeStart\n@ code_start\nbookmark SandboxArea\ncall render\nNO_ARGS\nbookmark EndSandboxArea\n\nbookmark EndCodeStart\nret\nNO_ARGS\n\n@ render\n# reset\nmov screen_y\nargu u_0 NULL UNIFORM_A NULL\n\t@ render_loop\n\tcall render_line\n\tNO_ARGS\n\t# increment & compare & jump if needed\n\tadd screen_y\n\targu screen_y u_1 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tcomp\n\targu screen_y u_display_size NULL UNIFORM_B\n\tjlt render_loop\n\tNO_ARGS\nadd u_pass_index\nargu u_pass_index u_1 UNIFORM_A UNIFORM_B\nret\nNO_ARGS\n\n@ render_line\n# reset\nmov screen_x\nargs core_id NULL\n\t@ render_line_loop\n\tcall render_pixel\n\tNO_ARGS\n\t# increment & compare & jump if needed\n\tadd screen_x\n\targu screen_x u_4 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tcomp\n\targu screen_x u_display_size NULL UNIFORM_B\n\tjlt render_line_loop\n\tNO_ARGS\nret\nNO_ARGS\n\n\n@ render_pixel\ncall calculate_pixel_position\nNO_ARGS\ncall initialize_ray\nNO_ARGS\ncall calculate_color\nNO_ARGS\n\n# clamp r g b to 255\nmin pixel_r\nargu pixel_r u_255 NULL UNIFORM_B\nmin pixel_g\nargu pixel_g u_255 NULL UNIFORM_B\nmin pixel_b\nargu pixel_b u_255 NULL UNIFORM_B\n\n# move stuff from pixel_x/y/r/g/b to the draw registers\nlshift draw_yx\nargu screen_y u_8 NULL UNIFORM_B\nlshift draw_gb\nargu pixel_g u_8 NULL UNIFORM_B\nor draw_yx\nargs draw_yx screen_x\nor draw_gb\nargs draw_gb pixel_b\nmov draw_r\nargs pixel_r NULL\n#mask pixels with pixel_w = 0\nmeq\nargu pixel_w u_0 NULL UNIFORM_B\n\t# draw command\n\tdraw draw_yx\n\tNO_ARGS\nmrt\nNO_ARGS\nret\nNO_ARGS\n\n@ calculate_pixel_position\n# pixel_xy = screen_xy - u_display_size / 2\nrshift a\nargu u_display_size u_1 UNIFORM_A UNIFORM_B\nnoop\nNO_ARGS\nsub pixel_x\nargs screen_x a\nsub pixel_y\nargs screen_y a\nret\nNO_ARGS\n\n@ initialize_ray\nmov ray_dir_x\nargs pixel_x NULL\nmov ray_dir_y\nargs pixel_y NULL\nmov ray_dir_z\nargu u_focal_length NULL UNIFORM_A NULL\n# make it a float\nlshift ray_dir_x\nargu ray_dir_x u_8 NULL UNIFORM_B\nlshift ray_dir_y\nargu ray_dir_y u_8 NULL UNIFORM_B\n\ncall normalize_ray_direction\nNO_ARGS\n\n# copy to ray_pos\nmov ray_pos_x\nargs ray_dir_x NULL\nmov ray_pos_y\nargs ray_dir_y NULL\nmov ray_pos_z\nargs ray_dir_z NULL\n\nret\nNO_ARGS\n\n@ normalize_ray_direction\n# 4 to preserve precision\n# returns a float format\n# shift to improve precision\nrshift ray_dir_x\nargu ray_dir_x u_4 NULL UNIFORM_B\nrshift ray_dir_y\nargu ray_dir_y u_4 NULL UNIFORM_B\nrshift ray_dir_z\nargu ray_dir_z u_4 NULL UNIFORM_B\n\n# square & find length\nmul b\nargs ray_dir_x ray_dir_x\nmul c\nargs ray_dir_y ray_dir_y\nmul d\nargs ray_dir_z ray_dir_z\nadd a\nargs b c\nnoop\nNO_ARGS\nadd a\nargs a d\nnoop\nNO_ARGS\nlookup RECIPROCAL_SQRT a\nargs a NULL\nnoop\nNO_ARGS\n\n# multiply each component by this\nmul ray_dir_x\nargs ray_dir_x a\nmul ray_dir_y\nargs ray_dir_y a\nmul ray_dir_z\nargs ray_dir_z a\n\nret\nNO_ARGS\n\n@ calculate_color\n# render different things depending on pass index\ncomp\nargu u_pass_index u_0 UNIFORM_A UNIFORM_B\njeq calculate_color_environment\nNO_ARGS\n\tcall eval_ray\n\tNO_ARGS\n\tret\n\tNO_ARGS\n@ calculate_color_environment\n\tcall eval_environment\n\tNO_ARGS\n\tmov pixel_w # set visibility of this pixel\n\targu u_1 NULL UNIFORM_A NULL\nret\nNO_ARGS\n\n@ eval_ray\n# oc = ray_pos - sphere_pos\nsub a\nargu ray_pos_x u_sphere_x NULL UNIFORM_B\nsub b\nargu ray_pos_y u_sphere_y NULL UNIFORM_B\nsub c\nargu ray_pos_z u_sphere_z NULL UNIFORM_B\n\n# dot(ray_dir, oc)\n# d stores b\nmul d\nargs ray_dir_x a\nmul e\nargs ray_dir_y b\nmul f\nargs ray_dir_z c\nadd d\nargs d e\nnoop\nNO_ARGS\nadd d\nargs d f\n\n\n# dot(oc, oc) - r squared\n# c stores c\nmul a\nargs a a\nmul b\nargs b b\nmul c\nargs c c\nadd a\nargs a b\nnoop\nNO_ARGS\nadd a\nargs a c\nmul b\nargu u_sphere_size u_sphere_size UNIFORM_A UNIFORM_B\nnoop\nNO_ARGS\nsub c\nargs a b\n\n# discriminant\n# discriminant is stored in e\n\nmul e\nargs d d\nnoop\nNO_ARGS\nsub e\nargs e c\nnoop\nNO_ARGS\nmax e\nargu e u_0 NULL UNIFORM_B\n\n# calculate hit point\n# f stores t\nlookup SQRT a\nargs e NULL\n\nsub f\nargu u_0 d UNIFORM_A NULL\nnoop\nNO_ARGS\nsub f\nargs f a\nnoop\nNO_ARGS\nmul hit_x\nargs ray_dir_x f\nmul hit_y\nargs ray_dir_y f\nmul hit_z\nargs ray_dir_z f\nadd hit_x\nargs hit_x ray_pos_x\nadd hit_y\nargs hit_y ray_pos_y\nadd hit_z\nargs hit_z ray_pos_z\n\n# calculate normals\nsub normal_x\nargu hit_x u_sphere_x NULL UNIFORM_B\nsub normal_y\nargu hit_y u_sphere_y NULL UNIFORM_B\nsub normal_z\nargu hit_z u_sphere_z NULL UNIFORM_B\nlookup RECIPROCAL d\nargu u_sphere_size NULL UNIFORM_A NULL\nnoop\nNO_ARGS\nmul normal_x\nargs normal_x d\nmul normal_y\nargs normal_y d\nmul normal_z\nargs normal_z d\n\n# calculate brightness\nmul a\nargu normal_x u_light_dir_x NULL UNIFORM_B\nmul b\nargu normal_y u_light_dir_y NULL UNIFORM_B\nmul c\nargu normal_z u_light_dir_z NULL UNIFORM_B\n\n#A is brightnexss\nadd a\nargs a b\nnoop\nNO_ARGS\nadd a\nargs a c\nnoop\nNO_ARGS\nmax a\nargu a u_16 NULL UNIFORM_B # ambient light\nnoop\nNO_ARGS\n\n# set the base color\n# stored in the temporary cr cg cb variables\nmul cr\nargu a u_sphere_r NULL UNIFORM_B\nmul cg\nargu a u_sphere_g NULL UNIFORM_B\nmul cb\nargu a u_sphere_b NULL UNIFORM_B\nmov pixel_w # set visibility of this pixel\nargs e NULL\n\n# calculate reflections\n# maybe can do some trick with the e to start this only when needed\n\n# dot(ray dir, normal)\nmul d\nargs ray_dir_x normal_x\nmul e\nargs ray_dir_y normal_y\nmul f\nargs ray_dir_z normal_z\nadd d\nargs d e\nnoop\nNO_ARGS\nadd d\nargs d f\nnoop\nNO_ARGS\n# 2x dot * normal\nlshift a #mul by 2\nargu d u_1 NULL UNIFORM_B\nnoop\nNO_ARGS\nmul d\nargs a normal_x\nmul e\nargs a normal_y\nmul f\nargs a normal_z\n\n# ray dir = ray dir - 2x dot * normal\n# this is the new ray dir\nsub ray_dir_x\nargs ray_dir_x d\nsub ray_dir_y\nargs ray_dir_y e\nsub ray_dir_z\nargs ray_dir_z f\n\n# sample the environment\ncall eval_environment\nNO_ARGS\n\n# reflections * reflectivity\nmul pixel_r\nargu pixel_r u_sphere_reflectivity NULL UNIFORM_B\nmul pixel_g\nargu pixel_g u_sphere_reflectivity NULL UNIFORM_B\nmul pixel_b\nargu pixel_b u_sphere_reflectivity NULL UNIFORM_B\n\n# 1 - reflectivity\nsub a\nargu u_h1 u_sphere_reflectivity UNIFORM_A UNIFORM_B\nnoop\nNO_ARGS\nmul cr\nargs cr a\nmul cg\nargs cg a\nmul cb\nargs cb a\n\n# combine reflections & base color\nadd pixel_r\nargs pixel_r cr\nadd pixel_g\nargs pixel_g cg\nadd pixel_b\nargs pixel_b cb\n\n\n# compute specular highlights\n# at this point the ray dir is already reflected\n# currently specular is puerly white light\nmul d\nargu ray_dir_x u_light_dir_x NULL UNIFORM_B\nmul e\nargu ray_dir_y u_light_dir_y NULL UNIFORM_B\nmul f\nargu ray_dir_z u_light_dir_z NULL UNIFORM_B\nadd d\nargs d e\nnoop\nNO_ARGS\nadd d\nargs d f\nnoop\nNO_ARGS\nmax d\nargu d u_0 NULL UNIFORM_B\nnoop\nNO_ARGS\nmul d\nargu d u_sphere_specular NULL UNIFORM_B\nnoop\nNO_ARGS\nadd pixel_r\nargs pixel_r d\nadd pixel_g\nargs pixel_g d\nadd pixel_b\nargs pixel_b d\n\nret\nNO_ARGS\n\n@ eval_environment\n# takes in ray_dir and computes the environment colors\n\n# defide whether to render sky or ground\n\n\t# 1 means full grass 0 means full dirt\n\tmov a\n\targu u_0 NULL UNIFORM_A NULL\n\t\n\t\n\tmul d\n\targu ray_dir_x u_h2 NULL UNIFORM_B\n\tmul f\n\targu ray_dir_x ray_dir_y NULL NULL\n\tmul e\n\targu ray_dir_y u_h8 NULL UNIFORM_B\n\tmul f\n\targu f u_16 NULL UNIFORM_B\n\tlookup SIN d\n\targs d NULL\n\tlookup SIN f\n\targs f NULL\n\tlookup SIN e\n\targs e NULL\n\tmul f\n\targu f u_h16 NULL UNIFORM_B\n\t\n\tadd a\n\targs d e\n\tnoop\n\tNO_ARGS\n\tadd a\n\targs a f\n\tnoop\n\tNO_ARGS\n\tmul a\n\targu a u_h4 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tmax a\n\targu a u_0 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tmin a\n\targu a u_h1 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\t\n\t#a * grass\n\tmul pixel_r\n\targu u_grass_r a UNIFORM_A NULL\n\tmul pixel_g\n\targu u_grass_g a UNIFORM_A NULL\n\tmul pixel_b\n\targu u_grass_b a UNIFORM_A NULL\n\t\n\t# introduce slight variation in grass\n\trand b\n\tNO_ARGS\n\tnoop\n\tNO_ARGS\n\tand b\n\targu b u_4 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tsub pixel_g\n\targs pixel_g b\n\t\n\t\n\t# (1 - a)\n\tsub a\n\targu u_h1 a UNIFORM_A NULL\n\tnoop\n\tNO_ARGS\n\t\n\t# (1 - a) * dirt)\n\tmul d\n\targu u_dirt_r a UNIFORM_A NULL\n\tmul e\n\targu u_dirt_g a UNIFORM_A NULL\n\tmul f\n\targu u_dirt_b a UNIFORM_A NULL\n\t\n\t# add together\n\tadd pixel_r\n\targs pixel_r d\n\tadd pixel_g\n\targs pixel_g e\n\tadd pixel_b\n\targs pixel_b f\n\t\nmlt\nargu u_ocean_height ray_dir_y UNIFORM_A NULL\n\n\t# render ocean\n\tmov pixel_r\n\targu u_ocean_r NULL UNIFORM_A NULL\n\tmov pixel_g\n\targu u_ocean_g NULL UNIFORM_A NULL\n\tmov pixel_b\n\targu u_ocean_b NULL UNIFORM_A NULL\n\t\n\t# introduce slight variation in ocean\n\t# 2 flows interweaved here\n\tmul a\n\targu ray_dir_y u_ocean_wave_magic NULL UNIFORM_B\n\tmul c\n\targu ray_dir_x u_32 NULL UNIFORM_B\n\trand b\n\tNO_ARGS\n\tadd c\n\targs c a\n\tlookup SIN a\n\targs a NULL\n\tlookup SIN c\n\targs c NULL\n\tmul c\n\targu c u_64 NULL UNIFORM_B\n\tand b\n\targu b u_16 NULL UNIFORM_B\n\tadd a\n\targs a c\n\tnoop\n\tNO_ARGS\n\tmax a\n\targu a u_ocean_wave_height NULL UNIFORM_B\n\tsub pixel_b\n\targs pixel_b b\n\tsub a\n\targu a u_ocean_wave_height NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tmul a\n\targu a u_16 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tadd pixel_r\n\targs pixel_r a\n\tadd pixel_g\n\targs pixel_g a\n\tadd pixel_b\n\targs pixel_b a\n\n\nmlt\nargu u_sky_height ray_dir_y UNIFORM_A NULL\n\n\t# render sky LERP(zenith, horizon) based on 'a'\n\tmul a\n\targu ray_dir_y u_minus_1 NULL UNIFORM_B\n\tnoop\n\tNO_ARGS\n\tmul pixel_r\n\targu u_sky_zenith_r a UNIFORM_A NULL\n\tmul pixel_g\n\targu u_sky_zenith_g a UNIFORM_A NULL\n\tmul pixel_b\n\targu u_sky_zenith_b a UNIFORM_A NULL\n\t\n\t# a = 1 - a\n\tsub a\n\targu u_h1 a UNIFORM_A NULL\n\tnoop\n\tNO_ARGS\n\tmul d\n\targu u_sky_horizon_r a UNIFORM_A NULL\n\tmul e\n\targu u_sky_horizon_g a UNIFORM_A NULL\n\tmul f\n\targu u_sky_horizon_b a UNIFORM_A NULL\n\t\n\tadd pixel_r\n\targs pixel_r d\n\tadd pixel_g\n\targs pixel_g e\n\tadd pixel_b\n\targs pixel_b f\n\nmrt\nNO_ARGS\n\nret\nNO_ARGS",
